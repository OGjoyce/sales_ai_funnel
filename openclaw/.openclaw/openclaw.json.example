{
  "agents": {
    "defaults": {
      "workspace": "/home/node/.openclaw/workspace"
    },
    "list": [
      {
        "id": "main"
      },
      {
        "id": "lina",
        "name": "lina",
        "workspace": "/home/node/.openclaw/workspace-lina",
        "agentDir": "/home/node/.openclaw/agents/lina/agent"
      },
      {
        "id": "fernando",
        "name": "fernando",
        "workspace": "/home/node/.openclaw/workspace-fernando",
        "agentDir": "/home/node/.openclaw/agents/fernando/agent"
      },
      {
        "id": "invoker",
        "name": "invoker",
        "workspace": "/home/node/.openclaw/workspace-invoker",
        "agentDir": "/home/node/.openclaw/agents/invoker/agent"
      }
    ]
  },
  "gateway": {
    "mode": "local",
    "auth": {
      "mode": "token",
      "token": "your_openclaw_gateway_token_here"
    },
    "port": 18789,
    "bind": "lan",
    "http": {
      "endpoints": {
        "chatCompletions": {
          "enabled": true
        }
      }
    }
  }
}
