APP_NAME=Velora
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=sales_ai_funnel
DB_USERNAME=sales
DB_PASSWORD=sales

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# CRM / OpenAI / OpenClaw / MCP
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_ORGANIZATION=
OPENCLAW_GATEWAY_URL=
# Bearer: OPENCLAW_API_KEY o (alias) OPENCLAW_GATEWAY_TOKEN
OPENCLAW_API_KEY=
OPENCLAW_GATEWAY_TOKEN=
OPENCLAW_SCRAPING_AGENT_ID=
# Slug del agente Lina en OpenClaw Control (ej. lina); modelo HTTP: openclaw/lina
OPENCLAW_LINA_AGENT_ID=
# Alleria en ~/.openclaw/openclaw.json → agents.list id "main"
OPENCLAW_ALLERIA_AGENT_ID=main
# Opcional: cabecera x-openclaw-agent-id para contexto amo (ej. amo); vacío = solo token operador
OPENCLAW_COMMS_OWNER_AGENT_ID=
# Si Lina y scraping van vacíos: slug del agente por defecto (suele ser default)
OPENCLAW_DEFAULT_AGENT_ID=default
OPENCLAW_COMMS_AGENT_ID=
OPENCLAW_WEBHOOK_SECRET=
# Timeout HTTP al gateway (segundos). Cola Lina: usar 600–900 y `php artisan queue:work`.
OPENCLAW_HTTP_TIMEOUT_SECONDS=900
MCP_SERVICE_TOKEN=
