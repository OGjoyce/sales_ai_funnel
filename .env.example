APP_NAME=Velora
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ============================================================
# DATABASE CONFIGURATION
# ============================================================
# For Docker setup: use DB_HOST=postgres and DB_PORT=5432
# For local setup: use DB_HOST=127.0.0.1 and DB_PORT=5433
# See .env.docker for Docker-specific settings
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=sales_ai_funnel
DB_USERNAME=sales
DB_PASSWORD=sales

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ============================================================
# QUEUE & CACHE CONFIGURATION
# ============================================================
# For Docker setup: use QUEUE_CONNECTION=redis and CACHE_STORE=redis
# For local setup: use QUEUE_CONNECTION=database and CACHE_STORE=database
# See .env.docker for Docker-specific settings
QUEUE_CONNECTION=database
CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

# ============================================================
# REDIS CONFIGURATION
# ============================================================
# For Docker setup: use REDIS_HOST=redis and REDIS_PORT=6379
# For local setup: use REDIS_HOST=127.0.0.1 and REDIS_PORT=6379
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ============================================================
# OPENAI API CONFIGURATION
# ============================================================
# Get your API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_ORGANIZATION=

# ============================================================
# OPENCLAW AGENT GATEWAY CONFIGURATION
# ============================================================
# For Docker setup: use OPENCLAW_GATEWAY_URL=http://openclaw:18789
# For local setup: use OPENCLAW_GATEWAY_URL=http://127.0.0.1:18789
OPENCLAW_GATEWAY_URL=

# Authentication token for OpenClaw gateway
OPENCLAW_API_KEY=
OPENCLAW_GATEWAY_TOKEN=

# Agent IDs configured in your OpenClaw instance (Docker entrypoint ensures "lina" exists)
OPENCLAW_LINA_AGENT_ID=lina
OPENCLAW_FERNANDO_AGENT_ID=fernando
OPENCLAW_ALLERIA_AGENT_ID=main
OPENCLAW_COMMS_OWNER_AGENT_ID=
OPENCLAW_DEFAULT_AGENT_ID=default
OPENCLAW_COMMS_AGENT_ID=
OPENCLAW_SCRAPING_AGENT_ID=

# Webhook security
OPENCLAW_WEBHOOK_SECRET=

# HTTP timeout for OpenClaw requests (seconds)
# Recommended: 600-900 for queue processing
OPENCLAW_HTTP_TIMEOUT_SECONDS=900

# ============================================================
# MCP (Model Context Protocol) SERVICE CONFIGURATION
# ============================================================
# Token for MCP service authentication
MCP_SERVICE_TOKEN=

# ============================================================
# VELORA SUPPORT & TRIAL
# ============================================================
VELORA_SUPPORT_EMAIL=soporte@velora.guatemalia.com
VELORA_WHATSAPP=
VELORA_CALENDLY_URL=https://calendly.com/ownstrpk4/free-consultation
VELORA_TRIAL_DAYS=7
VELORA_ALLOW_SKIP_EMAIL_VERIFICATION=true

# ============================================================
# STRIPE (Cashier — optional until checkout is enabled)
# ============================================================
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
CASHIER_CURRENCY=usd
